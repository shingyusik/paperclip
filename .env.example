# Copy this file to .env for repo-local development.
#
# PAPERCLIP_HOME keeps the dev database, storage, secrets, and logs separate
# from your normal Paperclip install.
PORT=3210
PAPERCLIP_HOME=.paperclip-local

# Required for authenticated auth flows. Local trusted dev mode can run without
# this, but keeping a stable dev secret avoids auth/session churn during tests.
BETTER_AUTH_SECRET=paperclip-dev-secret

# Optional: set DATABASE_URL only when you want to use an external Postgres.
# Leave it unset to use Paperclip's embedded dev database under PAPERCLIP_HOME.
# DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip

# Optional: normally pnpm dev serves the Vite UI through dev middleware.
# SERVE_UI is for serving a built UI bundle directly from the server.
# SERVE_UI=false

# Discord webhook for daily merge digest (scripts/discord-daily-digest.sh)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
